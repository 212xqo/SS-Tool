    "grim.jar","whiteout.jar","celestial.jar","vanadium.jar","thunderhack.jar","meow.jar","vegaline.jar",
    "hyperium.jar","clearmc.jar","catlean.jar","blackout.jar","argon.jar","driplite.jar","achilles.jar"
