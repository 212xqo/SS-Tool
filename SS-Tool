# ====================== COLLECT ALL FILES FIRST FOR ACCURATE PROGRESS ======================
Write-Host "Preparing deep scan (counting files)..." -ForegroundColor Yellow

$DeepScanPaths = @(
    "C:\Windows\System32", "C:\Windows\System32\drivers",
    "C:\Program Files", "C:\Program Files (x86)",
    "C:\Windows\Temp", "$env:TEMP", "$env:APPDATA", "$env:LOCALAPPDATA",
    "C:\cheats", "C:\Cheat", "C:\Hack",
    "$env:USERPROFILE\Downloads", "$env:USERPROFILE\Desktop"
)

$AllFiles = @()
foreach ($path in $DeepScanPaths) {
    if (Test-Path $path) {
        $AllFiles += Get-ChildItem $path -Recurse -File -ErrorAction SilentlyContinue -Include *.exe,*.dll,*.jar,*.sys -Depth 5
    }
}

# Add mods folder separately for .jar files
$modsPath = "$env:APPDATA\.minecraft\mods"
if (Test-Path $modsPath) {
    $AllFiles += Get-ChildItem $modsPath -Filter "*.jar" -Recurse -ErrorAction SilentlyContinue
}

$totalFiles = $AllFiles.Count
$processed = 0

Write-Host "Starting scan of $totalFiles files..." -ForegroundColor Cyan

# ====================== SCAN WITH PROGRESS BAR ======================
foreach ($file in $AllFiles) {
    $processed++
    $percent = if ($totalFiles -gt 0) { [math]::Round(($processed / $totalFiles) * 100, 1) } else { 0 }

    Write-Progress -Activity "Ocean Replica Deep Scan" `
                   -Status "Processing file $processed of $totalFiles ($percent%)" `
                   -PercentComplete $percent `
                   -CurrentOperation $file.FullName

    $fn = $file.Name.ToLower()

    if ($CheatFilePatterns -contains $fn -or ($AllCheatKeywords | Where-Object { $fn -like "*$_*" })) {
        Add-Finding "HIGH" "SystemFile" "Suspicious cheat-related file" $file.FullName
    }

    # String scan for .jar and large executables
    if ($file.Extension -in @(".jar", ".exe", ".dll") -and $file.Length -lt 50MB) {
        try {
            $content = Get-Content $file.FullName -Raw -ErrorAction SilentlyContinue
            foreach ($str in $AllCheatKeywords) {
                if ($content -like "*$str*") {
                    Add-Finding "HIGH" "StringMatch" "Client string '$str' found" $file.FullName
                    break
                }
            }
        } catch {}
    }
}

