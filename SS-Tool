# ====================== 6. RECYCLE BIN FORENSICS (EVEN AFTER EMPTY) + GHOST CLIENT GUESSING ======================
Write-Host "[+] Recovering ALL cleared Recycle Bin items + Ghost Client guessing..." -ForegroundColor Yellow

function Get-RecycleBinItems {
    $recycleRoot = "C:\`$Recycle.Bin"
    if (-not (Test-Path $recycleRoot)) { return }

    Get-ChildItem $recycleRoot -Directory -ErrorAction SilentlyContinue | ForEach-Object {
        $sidFolder = $_.FullName
        Get-ChildItem $sidFolder -Filter '$I*' -ErrorAction SilentlyContinue | ForEach-Object {
            $IFile = $_
            try {
                $bytes = [System.IO.File]::ReadAllBytes($IFile.FullName)
                if ($bytes.Length -lt 28) { return }

                $FileSize     = [System.BitConverter]::ToInt64($bytes, 8)
                $DeleteTime   = [System.DateTime]::FromFileTime([System.BitConverter]::ToInt64($bytes, 16))
                $PathLength   = [System.BitConverter]::ToInt32($bytes, 24) * 2
                $OriginalPath = [System.Text.Encoding]::Unicode.GetString($bytes, 28, $PathLength).Trim([char]0)

                $lowerPath = $OriginalPath.ToLower()
                $clientGuess = "Unknown"

                # Enhanced Ghost Client guessing
                if ($lowerPath -match "lumina") { $clientGuess = "Lumina Client (Ghost)" }
                elseif ($lowerPath -match "fusion") { $clientGuess = "Fusion+ (Ghost)" }
                elseif ($lowerPath -match "atlas") { $clientGuess = "Atlas Ghost Client" }
                elseif ($lowerPath -match "myau") { $clientGuess = "Myau Ghost Client" }
                elseif ($lowerPath -match "doomsday") { $clientGuess = "DoomsDay Ghost Client" }
                elseif ($lowerPath -match "prestige") { $clientGuess = "Prestige Ghost Client" }
                elseif ($lowerPath -match "phantom") { $clientGuess = "Phantom Ghost Client" }
                elseif ($lowerPath -match "incognito") { $clientGuess = "Incognito Ghost Client" }
                elseif ($lowerPath -match "raven") { $clientGuess = "Raven Variant (Ghost)" }
                elseif ($lowerPath -match "wurst") { $clientGuess = "Minecraft - Wurst Client" }
                elseif ($lowerPath -match "impact") { $clientGuess = "Minecraft - Impact Client" }
                elseif ($lowerPath -match "meteor") { $clientGuess = "Minecraft - Meteor Client" }
                elseif ($lowerPath -match "eulen|solara|ghost|rage") { $clientGuess = "FiveM - Ghost/Stealth Cheat" }
                elseif ($lowerPath -match "cheat|loader|injector|aimbot|esp") { $clientGuess = "Generic Cheat/Loader" }

                $severity = if ($lowerPath -match ($AllCheatKeywords -join "|")) { "HIGH" } else { "MEDIUM" }

                Add-Finding $severity "RecycleBin" "Cleared Recycle Bin item (deleted then emptied)" $OriginalPath "$clientGuess | Deleted: $($DeleteTime.ToString('yyyy-MM-dd HH:mm')) | Size: $FileSize bytes"
            } catch {}
        }
    }
}

