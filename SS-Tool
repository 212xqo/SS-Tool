<#
    SS-Tool - ULTIMATE DEEP SCAN WITH PROGRESS BAR
    Shows percentage + "X of Y files" during scan
#>

$Findings = @()
$High = @()
$Medium = @()
$Low = @()

function Add-Finding {
    param(
        [string]$Severity,
        [string]$Category,
        [string]$Description,
        [string]$Path = "N/A",
        [string]$Extra = ""
    )
    $obj = [PSCustomObject]@{
        Severity    = $Severity
        Category    = $Category
        Description = $Description
        Path        = $Path
        Extra       = $Extra
        Time        = (Get-Date -Format "HH:mm:ss")
    }
    if ($Severity -eq "HIGH") { $script:High += $obj }
    elseif ($Severity -eq "MEDIUM") { $script:Medium += $obj }
    else { $script:Low += $obj }
    $script:Findings += $obj
}

