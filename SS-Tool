<#
    SS-Tool - V1.7
    Every public string & detection method for ALL clients (Grim, Whiteout, Celestial, etc.)
    Silent mode - only shows results at the end
#>

$Findings = @()
$High = @()
$Medium = @()
$Low = @()

function Add-Finding {
    param(
        [string]$Severity,
        [string]$Category,
        [string]$Description,
        [string]$Path = "N/A",
        [string]$Extra = ""
    )
    $obj = [PSCustomObject]@{
        Severity    = $Severity
        Category    = $Category
        Description = $Description
        Path        = $Path
        Extra       = $Extra
        Time        = (Get-Date -Format "HH:mm:ss")
    }
    if ($Severity -eq "HIGH") { $script:High += $obj }
    elseif ($Severity -eq "MEDIUM") { $script:Medium += $obj }
    else { $script:Low += $obj }
    $script:Findings += $obj
}

# ====================== EVERY PUBLIC STRING + DETECTION SIGNATURE ======================
$GhostClientKeywords = @(
    "grim","grimclient","grimac","whiteout","whiteoutclient","whiteoutv3","celestial","celestialclient",
    "vanadium","vanadiumclient","thunderhack","thunderhackrecode","thunderhackv2","meow","meowclient",
    "vegaline","vegalineclient","hyperium","hyperiumclient","clearmc","clearmcclient","catlean","catleanclient",
    "blackout","blackoutclient","argon","argonclient","driplite","dripliteclient","achilles","achillesclient",
    "prestige","prestigeclient","lumina","fusion","fusionplus","atlas","myau","doomsday","incognito",
    "raven","ravenb","ravenb+","ravenb++","ravenb3","phantom","ghostclient","stealthclient","closetcheat",
    "MouseEvent","KeyInputEvent","RenderTickEvent","LivingUpdateEvent","ClientConnectedToServerEvent",
    "TickEvent","RenderWorldLastEvent","PlayerInteractEvent","InputEvent","MotionEvent","PacketEvent",
    "KillAura","CrystalAura","Scaffold","GodBridge","TellyBridge","Velocity","Reach","Critical","AutoClicker",
    "SilentAim","AutoTotem","NoSlow","Timer","Blink","Phase","Jesus","Speed","Fly","AntiKB","AntiAim"
)

$AllCheatKeywords = @(
    "wurst","impact","meteor","aristois","rise","future","liquidbounce","baritone","inertia","wraith",
    "salhack","kuro","bleachhack","pyro","sigma","xray","freecam","eulen","solara","rage","neverlose",
    "onetap","gamesense","aimware","supremacy","fanta","skeleton","ham","susano","skript",
    "lunar","feather","badlion","pvprp","fabric","forge","curseforge"
) + $GhostClientKeywords

$CheatProcessNames = $AllCheatKeywords

$CheatFilePatterns = @(
    "wurst.jar","impact.jar","meteor-client.jar","aristois.jar","rise.jar","future.jar","liquidbounce.jar",
    "eulen.exe","solara.exe","phantom.exe","ghost.exe","rage.exe","neverlose.dll","onetap.dll",
    "gamesense.dll","aimware.dll","loader.exe","injector.exe","cheat.dll","esp.dll","aimbot.dll",
    "lumina.jar","fusion.jar","atlas.jar","myau.jar","doomsday.jar","prestige.jar","raven.jar","incognito.jar",
    "grim.jar","grimclient.jar","whiteout.jar","whiteoutclient.jar","celestial.jar","celestialclient.jar",
    "vanadium.jar","thunderhack.jar","thunderhackrecode.jar","meow.jar","meowclient.jar","vegaline.jar",
    "hyperium.jar","clearmc.jar","catlean.jar","blackout.jar","argon.jar","driplite.jar","achilles.jar"
)

# ====================== SILENT SCANNING ======================

# 1. Running Processes
Get-Process | ForEach-Object {
    $name = $_.Name.ToLower()
    $path = $_.Path
    if ($CheatProcessNames -contains $name -or $name -match ($AllCheatKeywords -join "|")) {
        $clientType = if ($GhostClientKeywords -contains $name) { "GHOST CLIENT" } else { "Cheat/Injector" }
        Add-Finding "HIGH" "Process" "$clientType process detected" $path "Client: $($name.ToUpper())"
    }
}

# 2. Common Cheat Directories + Files
$CommonCheatPaths = @(
    "$env:APPDATA\.minecraft\versions", "$env:APPDATA\.minecraft\mods", "$env:APPDATA\.minecraft\config",
    "$env:LOCALAPPDATA\FiveM\FiveM.app\data", "$env:APPDATA\FiveM",
    "$env:USERPROFILE\Downloads\cheat", "$env:USERPROFILE\Desktop\cheat", "$env:TEMP",
    "$env:APPDATA\cheat", "$env:APPDATA\loader", "C:\cheats", "C:\Cheat", "C:\Hack",
    "$env:APPDATA\.fabric", "$env:APPDATA\.curseforge", "$env:LOCALAPPDATA\Programs\cheat",
    "$env:USERPROFILE\.lunarclient", "$env:USERPROFILE\.pvprp", "$env:APPDATA\.feather",
    "$env:APPDATA\.badlion", "$env:APPDATA\.minecraft\launcher_profiles.json"
)

foreach ($p in $CommonCheatPaths) {
    if (Test-Path $p) {
        Get-ChildItem $p -Recurse -File -ErrorAction SilentlyContinue | Select-Object -First 150 | ForEach-Object {
            $fn = $_.Name.ToLower()
            if ($CheatFilePatterns -contains $fn -or $fn -match ($AllCheatKeywords -join "|")) {
                Add-Finding "HIGH" "File" "Known Ghost/Cheat client file" $_.FullName
            }
        }
        Add-Finding "MEDIUM" "Directory" "Common cheat/Ghost directory present" $p
    }
}

# 3. Deep .jar scan (mods folder)
$modsPath = "$env:APPDATA\.minecraft\mods"
if (Test-Path $modsPath) {
    Get-ChildItem $modsPath -Filter "*.jar" -Recurse -ErrorAction SilentlyContinue | Select-Object -First 100 | ForEach-Object {
        try {
            $content = Get-Content $_.FullName -Raw -ErrorAction SilentlyContinue
            foreach ($str in $AllCheatKeywords) {
                if ($content -match $str) {
                    Add-Finding "HIGH" "JarString" "Client string '$str' found inside .jar" $_.FullName
                    break
                }
            }
            if ($content -match "MouseEvent|KeyInputEvent|RenderTickEvent") {
                Add-Finding "HIGH" "JarHook" "Hollow Detect - Event hook found" $_.FullName
            }
        } catch {}
    }
}

# 4. Prefetch
$prefetchPath = "C:\Windows\Prefetch"
if (Test-Path $prefetchPath) {
    Get-ChildItem $prefetchPath -Filter "*.pf" | ForEach-Object {
        if ($_.Name.ToLower() -match ($AllCheatKeywords -join "|")) {
            Add-Finding "HIGH" "Prefetch" "Executed Ghost/Cheat client (Prefetch evidence)" $_.FullName
        }
    }
}

# 5. Recent files
$recentPath = "$env:APPDATA\Microsoft\Windows\Recent"
if (Test-Path $recentPath) {
    Get-ChildItem $recentPath -Filter "*.lnk" -ErrorAction SilentlyContinue | ForEach-Object {
        try {
            $target = (New-Object -ComObject WScript.Shell).CreateShortcut($_.FullName).TargetPath
            if ($target -and $target.ToLower() -match ($AllCheatKeywords -join "|")) {
                Add-Finding "MEDIUM" "Recent" "Recently accessed Ghost/Cheat file" $target
            }
        } catch {}
    }
}

# 6. Registry & Security checks
$ci = Get-ItemProperty -Path "HKLM:\SYSTEM\CurrentControlSet\Control\DeviceGuard" -Name "EnableVirtualizationBasedSecurity" -ErrorAction SilentlyContinue
if ($ci -and $ci.EnableVirtualizationBasedSecurity -ne 1) {
    Add-Finding "MEDIUM" "Security" "Core Isolation / VBS disabled" "DeviceGuard"
}

$defender = Get-MpPreference -ErrorAction SilentlyContinue
if ($defender -and $defender.DisableRealtimeMonitoring -eq $true) {
    Add-Finding "HIGH" "Security" "Windows Defender real-time protection disabled" "Defender"
}

# 7. Recycle Bin Recovery (even after Empty Recycle Bin)
$recycleRoot = "C:\`$Recycle.Bin"
if (Test-Path $recycleRoot) {
    Get-ChildItem $recycleRoot -Directory -ErrorAction SilentlyContinue | ForEach-Object {
        $sidFolder = $_.FullName
        Get-ChildItem $sidFolder -Filter '$I*' -ErrorAction SilentlyContinue | ForEach-Object {
            try {
                $bytes = [System.IO.File]::ReadAllBytes($_.FullName)
                if ($bytes.Length -lt 28) { return }

                $FileSize     = [System.BitConverter]::ToInt64($bytes, 8)
                $DeleteTime   = [System.DateTime]::FromFileTime([System.BitConverter]::ToInt64($bytes, 16))
                $PathLength   = [System.BitConverter]::ToInt32($bytes, 24) * 2
                $OriginalPath = [System.Text.Encoding]::Unicode.GetString($bytes, 28, $PathLength).Trim([char]0)

                $lowerPath = $OriginalPath.ToLower()
                $clientGuess = "Unknown"

                if     ($lowerPath -match "grim")          { $clientGuess = "Grim Client (Ghost)" }
                elseif ($lowerPath -match "whiteout")      { $clientGuess = "Whiteout v3 Ghost Client" }
                elseif ($lowerPath -match "celestial")     { $clientGuess = "Celestial Client" }
                elseif ($lowerPath -match "vanadium")      { $clientGuess = "Vanadium Client" }
                elseif ($lowerPath -match "thunderhack")   { $clientGuess = "ThunderHack Recode" }
                elseif ($lowerPath -match "meow")          { $clientGuess = "Meow Client" }
                elseif ($lowerPath -match "vegaline")      { $clientGuess = "VegaLine Client" }
                elseif ($lowerPath -match "hyperium")      { $clientGuess = "Hyperium Client" }
                elseif ($lowerPath -match "clearmc")       { $clientGuess = "ClearMC Client" }
                elseif ($lowerPath -match "catlean")       { $clientGuess = "Catlean Client" }
                elseif ($lowerPath -match "blackout")      { $clientGuess = "Blackout Client" }
                elseif ($lowerPath -match "argon")         { $clientGuess = "Argon Client" }
                elseif ($lowerPath -match "driplite")      { $clientGuess = "DripLite Client" }
                elseif ($lowerPath -match "achilles")      { $clientGuess = "Achilles Client" }
                elseif ($lowerPath -match "prestige")      { $clientGuess = "Prestige Ghost Client" }
                elseif ($lowerPath -match "lumina|fusion|atlas|myau|doomsday|incognito|raven") { $clientGuess = "Other Ghost Client" }
                elseif ($lowerPath -match "wurst|impact|meteor|aristois|rise|future|liquidbounce") { $clientGuess = "Minecraft - Public Cheat Client" }
                elseif ($lowerPath -match "eulen|solara|ghost|rage") { $clientGuess = "FiveM - Ghost/Stealth Cheat" }
                else { $clientGuess = "Generic Cheat/Loader" }

                $severity = if ($lowerPath -match ($AllCheatKeywords -join "|")) { "HIGH" } else { "MEDIUM" }
                Add-Finding $severity "RecycleBin" "Cleared Recycle Bin item" $OriginalPath "$clientGuess | Deleted: $($DeleteTime.ToString('yyyy-MM-dd HH:mm')) | Size: $FileSize bytes"
            } catch {}
        }
    }
}

# ====================== FINAL REPORT (ONLY OUTPUT) ======================
Write-Host "`n================================================================" -ForegroundColor DarkGray
