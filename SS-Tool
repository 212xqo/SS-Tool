    Write-Host "`nNo high or medium risk detections found." -ForegroundColor Green
    Write-Host "System appears clean according to this replica scan." -ForegroundColor Green
} else {
    Write-Host "`nDetections found - This is an educational replica only." -ForegroundColor Yellow
}

