        [string]$Category,
        [string]$Description,
        [string]$Path = "N/A",
        [string]$Extra = ""
    )
    $obj = [PSCustomObject]@{
        Severity    = $Severity
        Category    = $Category
        Description = $Description
        Path        = $Path
        Extra       = $Extra
        Time        = (Get-Date -Format "HH:mm:ss")
