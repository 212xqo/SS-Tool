<#
    SS-Tool - OPTIMIZED + PARALLEL + PROGRESS + HTML EXPORT
    Fastest version with real progress and automatic report
#>

$Findings = @()
$High = @()
$Medium = @()
$Low = @()

function Add-Finding {
    param([string]$Severity, [string]$Category, [string]$Description, [string]$Path = "N/A", [string]$Extra = "")
    $obj = [PSCustomObject]@{
        Severity    = $Severity
        Category    = $Category
        Description = $Description
        Path        = $Path
        Extra       = $Extra
        Time        = (Get-Date -Format "HH:mm:ss")
    }
    if ($Severity -eq "HIGH") { $script:High += $obj }
    elseif ($Severity -eq "MEDIUM") { $script:Medium += $obj }
    else { $script:Low += $obj }
}

# Keywords
$AllCheatKeywords = @("wurst","impact","meteor","aristois","rise","future","liquidbounce","baritone","inertia","wraith","salhack","kuro","bleachhack","pyro","sigma","xray","freecam","eulen","solara","rage","neverlose","onetap","gamesense","aimware","supremacy","fanta","skeleton","ham","susano","skript","lunar","feather","badlion","pvprp","fabric","forge","curseforge","grim","grimclient","grimac","whiteout","whiteoutclient","whiteoutv3","celestial","celestialclient","vanadium","vanadiumclient","thunderhack","thunderhackrecode","thunderhackv2","meow","meowclient","vegaline","vegalineclient","hyperium","hyperiumclient","clearmc","clearmcclient","catlean","catleanclient","blackout","blackoutclient","argon","argonclient","driplite","dripliteclient","achilles","achillesclient","prestige","prestigeclient","lumina","fusion","fusionplus","atlas","myau","doomsday","incognito","raven","ravenb","ravenb+","ravenb++","ravenb3","phantom","ghostclient","stealthclient","closetcheat")

$GhostClientKeywords = @("grim","whiteout","celestial","vanadium","thunderhack","meow","vegaline","hyperium","clearmc","catlean","blackout","argon","driplite","achilles","prestige","lumina","fusion","atlas","myau","doomsday","incognito","raven","phantom")

$CheatFilePatterns = @("wurst.jar","impact.jar","meteor-client.jar","aristois.jar","rise.jar","future.jar","liquidbounce.jar","eulen.exe","solara.exe","phantom.exe","ghost.exe","rage.exe","neverlose.dll","onetap.dll","gamesense.dll","aimware.dll","loader.exe","injector.exe","cheat.dll","esp.dll","aimbot.dll","lumina.jar","fusion.jar","atlas.jar","myau.jar","doomsday.jar","prestige.jar","raven.jar","incognito.jar","grim.jar","whiteout.jar","celestial.jar","vanadium.jar","thunderhack.jar","meow.jar","vegaline.jar","hyperium.jar","clearmc.jar","catlean.jar","blackout.jar","argon.jar","driplite.jar","achilles.jar")

# ====================== COLLECT FILES EFFICIENTLY ======================
Write-Host "Preparing optimized scan..." -ForegroundColor Yellow

$DeepScanPaths = @(
    "C:\Windows\System32", "C:\Windows\System32\drivers",
    "C:\Program Files", "C:\Program Files (x86)",
    "$env:APPDATA", "$env:LOCALAPPDATA", "$env:TEMP",
    "$env:USERPROFILE\Downloads", "$env:USERPROFILE\Desktop"
)

$AllFiles = @()
foreach ($path in $DeepScanPaths) {
    if (Test-Path $path) {
        $AllFiles += Get-ChildItem -Path $path -Recurse -File -Depth 4 -ErrorAction SilentlyContinue
    }
}

$modsPath = "$env:APPDATA\.minecraft\mods"
if (Test-Path $modsPath) {
    $AllFiles += Get-ChildItem -Path $modsPath -Filter "*.jar" -Recurse -ErrorAction SilentlyContinue
}

$totalFiles = $AllFiles.Count
Write-Host "Starting parallel scan of $totalFiles files..." -ForegroundColor Cyan

# ====================== PARALLEL SCAN WITH PROGRESS ======================
$processed = 0

$AllFiles | ForEach-Object -Parallel {
    $file = $_
    $global:processed++
    $percent = [math]::Round(($using:processed / $using:totalFiles) * 100, 1)

    if ($global:processed % 30 -eq 0) {
        Write-Progress -Activity "SS-Tool Deep Scan" -Status "Processing $global:processed of $using:totalFiles ($percent%)" -PercentComplete $percent
    }

    $fn = $file.Name.ToLower()

    if ($using:CheatFilePatterns -contains $fn -or ($using:AllCheatKeywords | Where-Object { $fn -like "*$_*" })) {
        $using:Findings += [PSCustomObject]@{
            Severity = "HIGH"; Category = "SystemFile"; Description = "Suspicious cheat-related file"; Path = $file.FullName
        }
    }

    if ($file.Extension -in @(".jar",".exe",".dll") -and $file.Length -lt 30MB) {
        try {
            $content = Get-Content $file.FullName -Raw -ErrorAction SilentlyContinue
            foreach ($str in $using:AllCheatKeywords) {
                if ($content -like "*$str*") {
                    $using:Findings += [PSCustomObject]@{
                        Severity = "HIGH"; Category = "StringMatch"; Description = "Client string '$str' found"; Path = $file.FullName
                    }
                    break
                }
            }
        } catch {}
    }
} -ThrottleLimit 8   # Adjust based on your CPU (8 is good balance)

# Quick checks (Processes, Security, Recycle Bin)
Get-Process | ForEach-Object {
    $name = $_.Name.ToLower()
    if ($AllCheatKeywords -contains $name -or ($AllCheatKeywords | Where-Object { $name -like "*$_*" })) {
        $type = if ($GhostClientKeywords -contains $name) { "GHOST CLIENT" } else { "Cheat" }
        Add-Finding "HIGH" "Process" "$type process detected" $_.Path "Client: $($name.ToUpper())"
    }
}

# Security
if ((Get-ItemProperty -Path "HKLM:\SYSTEM\CurrentControlSet\Control\DeviceGuard" -Name "EnableVirtualizationBasedSecurity" -EA SilentlyContinue).EnableVirtualizationBasedSecurity -ne 1) {
    Add-Finding "MEDIUM" "Security" "Core Isolation / VBS disabled" "DeviceGuard"
}
if ((Get-MpPreference -EA SilentlyContinue).DisableRealtimeMonitoring -eq $true) {
    Add-Finding "HIGH" "Security" "Windows Defender real-time protection disabled" "Defender"
}

Write-Progress -Activity "SS-Tool Deep Scan" -Completed

# ====================== FINAL REPORT + HTML EXPORT ======================
$reportPath = "$env:USERPROFILE\Desktop\SS-Tool-Report-$(Get-Date -Format 'yyyyMMdd-HHmmss').html"

$html = @"
<html><head><title>SS-Tool Scan Report</title>
<style>body{font-family:Consolas;background:#111;color:#0f0;} table{border-collapse:collapse;width:100%;} th,td{border:1px solid #333;padding:8px;} th{background:#222;}</style>
</head><body>
<h1>SS-Tool - Deep Scan Report</h1>
<p>Scan completed at $(Get-Date) | Total files scanned: $totalFiles</p>
"@

if ($High.Count -gt 0) {
    $html += "<h2 style='color:red'>HIGH RISK DETECTIONS ($($High.Count))</h2>"
    $html += $High | ConvertTo-Html -Fragment
}
if ($Medium.Count -gt 0) {
    $html += "<h2 style='color:yellow'>MEDIUM WARNINGS ($($Medium.Count))</h2>"
    $html += $Medium | ConvertTo-Html -Fragment
}

$html += "<p style='color:gray'>Educational replica only - Not affiliated with anticheat.ac</p></body></html>"

$html | Out-File -FilePath $reportPath -Encoding UTF8

Write-Host "`n================================================================" -ForegroundColor DarkGray
Write-Host "                SS-Tool - OPTIMIZED SCAN COMPLETE" -ForegroundColor Cyan
Write-Host "================================================================" -ForegroundColor DarkGray
Write-Host "Total files scanned : $totalFiles" -ForegroundColor Gray
Write-Host "Report saved to     : $reportPath" -ForegroundColor Green

if ($High.Count -gt 0) {
    Write-Host "`nHIGH RISK DETECTIONS ($($High.Count))" -ForegroundColor Red
    $High | Format-Table -AutoSize
}

if ($Medium.Count -gt 0) {
    Write-Host "`nMEDIUM / WARNING DETECTIONS ($($Medium.Count))" -ForegroundColor Yellow
    $Medium | Format-Table -AutoSize
}

if ($High.Count -eq 0 -and $Medium.Count -eq 0) {
    Write-Host "`nNo high or medium risk detections found." -ForegroundColor Green
}

Write-Host "`nScan finished. HTML report saved to Desktop." -ForegroundColor Cyan
